//@version=5
strategy(
     "AtlasQuant OTE Research V1",
     overlay=true,
     pyramiding=0,
     process_orders_on_close=false,
     calc_on_order_fills=true,
     initial_capital=10000,
     commission_type=strategy.commission.percent,
     commission_value=0.0
)

// Technical-only OTE 62%-79% research bridge.
// Single-series logic; macro/Fed context is not reproduced here.

groupOTE       = "OTE"
lookback       = input.int(28, "Lookback do impulso", minval=8, maxval=100, group=groupOTE)
recentExtreme  = input.int(12, "Extremo recente", minval=1, maxval=50, group=groupOTE)
atrLen         = input.int(14, "ATR", minval=2, maxval=100, group=groupOTE)
minImpulseAtr  = input.float(0.0, "Impulso mínimo / ATR", minval=0.0, maxval=20.0, step=0.25, group=groupOTE)
entryMode      = input.string("Sweet 70.5", "Entrada", options=["Sweet 70.5","Zone midpoint"], group=groupOTE)
stopBufferAtr  = input.float(0.05, "Buffer do stop (ATR)", minval=0.0, maxval=1.0, step=0.01, group=groupOTE)
rrTarget       = input.float(2.0, "Alvo em R", minval=0.25, maxval=10.0, step=0.25, group=groupOTE)
maxSetupAge    = input.int(8, "Validade do setup (candles)", minval=1, maxval=100, group=groupOTE)
sideFilter     = input.string("Both", "Lados", options=["Both","Long only","Short only"], group=groupOTE)

groupSession = "Sessão"
tradeSession = input.session("0000-2359", "Janela permitida", group=groupSession)
inSession    = not na(time(timeframe.period, tradeSession))

atr = ta.atr(atrLen)
replayReady = bar_index >= lookback - 1 and not na(atr)
longAllowed  = sideFilter != "Short only"
shortAllowed = sideFilter != "Long only"

findBuyImpulse() =>
    float hi = na
    float lo = na
    int hiOff = na
    int loOff = na
    for i = 0 to recentExtreme - 1
        if not na(high[i]) and (na(hi) or high[i] > hi)
            hi := high[i]
            hiOff := i
    if not na(hiOff)
        for i = hiOff to lookback - 1
            if not na(low[i]) and (na(lo) or low[i] < lo)
                lo := low[i]
                loOff := i
    valid = not na(hiOff) and not na(loOff) and loOff > hiOff and hi > lo
    [valid, lo, hi, loOff, hiOff]

findSellImpulse() =>
    float hi = na
    float lo = na
    int hiOff = na
    int loOff = na
    for i = 0 to recentExtreme - 1
        if not na(low[i]) and (na(lo) or low[i] < lo)
            lo := low[i]
            loOff := i
    if not na(loOff)
        for i = loOff to lookback - 1
            if not na(high[i]) and (na(hi) or high[i] > hi)
                hi := high[i]
                hiOff := i
    valid = not na(hiOff) and not na(loOff) and hiOff > loOff and hi > lo
    [valid, lo, hi, loOff, hiOff]

[buyValid, buyLo, buyHi, buyLoOff, buyHiOff] = findBuyImpulse()
[sellValid, sellLo, sellHi, sellLoOff, sellHiOff] = findSellImpulse()

buyRange = buyValid ? buyHi - buyLo : na
sellRange = sellValid ? sellHi - sellLo : na
buyRetr = buyValid and buyRange > 0 ? (buyHi - close) / buyRange : na
sellRetr = sellValid and sellRange > 0 ? (close - sellLo) / sellRange : na
buyInside = replayReady and buyValid and buyRange >= atr * minImpulseAtr and buyRetr >= 0.62 and buyRetr <= 0.79
sellInside = replayReady and sellValid and sellRange >= atr * minImpulseAtr and sellRetr >= 0.62 and sellRetr <= 0.79

buySweet = buyValid ? buyHi - 0.705 * buyRange : na
sellSweet = sellValid ? sellLo + 0.705 * sellRange : na
buyZ62 = buyValid ? buyHi - 0.62 * buyRange : na
buyZ79 = buyValid ? buyHi - 0.79 * buyRange : na
sellZ62 = sellValid ? sellLo + 0.62 * sellRange : na
sellZ79 = sellValid ? sellLo + 0.79 * sellRange : na

buyDist = buyInside ? math.abs(buyRetr - 0.705) : 999.0
sellDist = sellInside ? math.abs(sellRetr - 0.705) : 999.0
chooseBuy = buyInside and longAllowed and (not sellInside or not shortAllowed or buyDist <= sellDist)
chooseSell = sellInside and shortAllowed and (not buyInside or not longAllowed or sellDist < buyDist)

buyLoBar = buyValid ? bar_index - buyLoOff : na
buyHiBar = buyValid ? bar_index - buyHiOff : na
sellLoBar = sellValid ? bar_index - sellLoOff : na
sellHiBar = sellValid ? bar_index - sellHiOff : na

var int lastBuyLoBar = na
var int lastBuyHiBar = na
var int lastSellLoBar = na
var int lastSellHiBar = na
var int pendingSide = 0
var int setupBar = na
var float zoneLow = na
var float zoneHigh = na
var float pendingEntry = na
var float pendingStop = na
var float pendingTarget = na

cancelPending() =>
    strategy.cancel("OTE-L")
    strategy.cancel("OTE-S")

newBuyImpulse = chooseBuy and (buyLoBar != lastBuyLoBar or buyHiBar != lastBuyHiBar)
newSellImpulse = chooseSell and (sellLoBar != lastSellLoBar or sellHiBar != lastSellHiBar)

if newBuyImpulse
    cancelPending()
    pendingSide := 0
    lastBuyLoBar := buyLoBar
    lastBuyHiBar := buyHiBar
    if inSession and strategy.position_size == 0
        zoneLow := math.min(buyZ62,buyZ79)
        zoneHigh := math.max(buyZ62,buyZ79)
        pendingEntry := entryMode == "Sweet 70.5" ? buySweet : (buyZ62 + buyZ79) / 2.0
        pendingStop := buyLo - atr * stopBufferAtr
        risk = pendingEntry - pendingStop
        pendingTarget := pendingEntry + risk * rrTarget
        setupBar := bar_index
        pendingSide := risk > syminfo.mintick ? 1 : 0

if newSellImpulse
    cancelPending()
    pendingSide := 0
    lastSellLoBar := sellLoBar
    lastSellHiBar := sellHiBar
    if inSession and strategy.position_size == 0
        zoneLow := math.min(sellZ62,sellZ79)
        zoneHigh := math.max(sellZ62,sellZ79)
        pendingEntry := entryMode == "Sweet 70.5" ? sellSweet : (sellZ62 + sellZ79) / 2.0
        pendingStop := sellHi + atr * stopBufferAtr
        risk = pendingStop - pendingEntry
        pendingTarget := pendingEntry - risk * rrTarget
        setupBar := bar_index
        pendingSide := risk > syminfo.mintick ? -1 : 0

pendingExpired = pendingSide != 0 and not na(setupBar) and bar_index - setupBar > maxSetupAge
if pendingExpired and strategy.position_size == 0
    cancelPending()
    pendingSide := 0

if pendingSide == 1 and strategy.position_size == 0
    strategy.entry("OTE-L", strategy.long, limit=pendingEntry)
    strategy.exit("OTE-LX", "OTE-L", stop=pendingStop, limit=pendingTarget)

if pendingSide == -1 and strategy.position_size == 0
    strategy.entry("OTE-S", strategy.short, limit=pendingEntry)
    strategy.exit("OTE-SX", "OTE-S", stop=pendingStop, limit=pendingTarget)

if strategy.position_size > 0
    pendingSide := 0
    strategy.exit("OTE-LX", "OTE-L", stop=pendingStop, limit=pendingTarget)

if strategy.position_size < 0
    pendingSide := 0
    strategy.exit("OTE-SX", "OTE-S", stop=pendingStop, limit=pendingTarget)

plotshape(newBuyImpulse, title="Buy OTE", text="OTE↑", style=shape.labelup, location=location.belowbar, size=size.tiny)
plotshape(newSellImpulse, title="Sell OTE", text="OTE↓", style=shape.labeldown, location=location.abovebar, size=size.tiny)

plot(pendingSide != 0 or strategy.position_size != 0 ? zoneHigh : na, "OTE High", style=plot.style_linebr)
plot(pendingSide != 0 or strategy.position_size != 0 ? zoneLow : na, "OTE Low", style=plot.style_linebr)
plot(pendingSide != 0 or strategy.position_size != 0 ? pendingEntry : na, "Entry", style=plot.style_linebr)
plot(strategy.position_size != 0 ? pendingStop : na, "Stop", style=plot.style_linebr)
plot(strategy.position_size != 0 ? pendingTarget : na, "Target", style=plot.style_linebr)

alertcondition(newBuyImpulse, "AtlasQuant Buy OTE", "AtlasQuant: BUY entrou na zona OTE")
alertcondition(newSellImpulse, "AtlasQuant Sell OTE", "AtlasQuant: SELL entrou na zona OTE")

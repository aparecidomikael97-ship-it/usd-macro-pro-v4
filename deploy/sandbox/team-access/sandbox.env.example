# Copy to sandbox.env.local. Never commit sandbox.env.local.
# This file contains placeholders only.
ATLASQUANT_SANDBOX_ONLY=true

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.5
POSTGRES_IMAGE=postgres:18.6

KEYCLOAK_HTTP_PORT=18080
REGISTRY_DB_PORT=15432

KC_BOOTSTRAP_ADMIN_USERNAME=atlasquant-sandbox-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD

KC_DB_USERNAME=keycloak_sandbox
KC_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_KEYCLOAK_DB_PASSWORD

REGISTRY_DB_USERNAME=atlasquant_registry_sandbox
REGISTRY_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_REGISTRY_DB_PASSWORD
